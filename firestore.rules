rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Chaque famille a un code secret de 14 caractères (ex. ABCD-EFGH-JKLM).
    match /families/{family} {
      allow read, write: if request.auth != null && family.size() == 14;
      match /messages/{message} {
        allow read, write: if request.auth != null && family.size() == 14;
      }
    }
  }
}
